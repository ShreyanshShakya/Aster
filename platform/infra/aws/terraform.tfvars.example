# Copy this file to terraform.tfvars. Do not commit terraform.tfvars.
aws_region             = "ap-south-1"
project_name           = "aster-test"
teardown_date          = "2026-08-01"
allowed_dashboard_cidr = "203.0.113.10/32"

# Recommended for the temporary all-in-one Docker + two CPU DMLF agent test.
instance_type       = "t3.xlarge"
root_volume_size_gb = 50

# Keep false unless you need a stable IP for the short test window.
allocate_elastic_ip = false

# Optional, but recommended for a disposable test.
budget_alert_email = "you@example.com"
budget_limit_usd   = 15
