POSTGRES_DB=aster
POSTGRES_USER=aster
POSTGRES_PASSWORD=change-me-for-production
DATABASE_URL=postgresql+psycopg://aster:change-me-for-production@postgres:5432/aster
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=aster-artifacts
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_MINUTES=1440
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Optional: enables OpenAlex enrichment. Without it, Crossref metadata is used.
OPENALEX_API_KEY=
CROSSREF_MAILTO=
# Optional: enables the real async DMLF executor. The bridge must already be running.
DMLF_ADAPTER_ENABLED=false
DMLF_BRIDGE_ENDPOINT=
DMLF_REQUESTED_NODES=1
